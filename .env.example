# ============================================================
# Clarify 环境变量示例（复制为 .env.local 并填写真实值）
# ============================================================

# ---- Supabase（M0 必需）----
# 项目地址与匿名密钥：Supabase 控制台 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- AI 模型（M1 起使用，统一 OpenAI 兼容接口）----
# 通义千问 DashScope（主力模型 Qwen3-Max / 视觉 Qwen-VL）
DASHSCOPE_API_KEY=sk-xxx
# DeepSeek（降本模型 DeepSeek-V4-Flash）
DEEPSEEK_API_KEY=sk-xxx

# ---- 可选 ----
# 首页默认重定向目标
# NEXT_PUBLIC_DEFAULT_REDIRECT=/library
